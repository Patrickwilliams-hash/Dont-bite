// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DrillFrequency {
  weekly
  fortnightly
  monthly
}

enum UserRole {
  user
  admin
}

enum AdminTier {
  super_admin
  administrator
}

enum DrillDeliveryStatus {
  queued
  sending
  sent
  failed
  cancelled
}

enum DrillDeliveryPurpose {
  demo
  training
}

enum DrillInteractionType {
  link_visit
  first_input_attempt
}

enum DrillOutcome {
  pending
  no_interaction
  link_followed
  input_attempted
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  mustChangePassword Boolean   @default(false)
  frequency    DrillFrequency
  role         UserRole       @default(user)
  adminTier    AdminTier?
  adminPermissions String[]   @default([])
  isActive     Boolean        @default(true)
  trainingActive Boolean      @default(true)
  joinedAt     DateTime       @default(now())
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  passwordUpdatedAt DateTime  @default(now())
  resetTokens  PasswordResetToken[]
  sessions     Session[]
  auditLogsAsActor AdminAuditLog[] @relation("AuditActor")
  emailChangeRequests EmailChangeRequest[]
  drillDeliveriesReceived DrillDelivery[] @relation("DrillRecipient")
  drillDeliveriesTriggered DrillDelivery[] @relation("DrillTriggered")
  drillTemplatesCreated DrillTemplate[] @relation("DrillTemplateCreator")
}

model DrillTemplate {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  scamType         String
  brandName        String
  fakeDomain       String
  realDomainHint   String
  redFlags         Json
  whyDangerous     String   @db.Text
  howToSpot        Json
  learnSlug        String
  emailSubject     String?
  emailPreviewText String?
  emailBodyHtml    String?  @db.Text
  emailBodyText    String?  @db.Text
  interactionType  DrillInteractionType @default(link_visit)
  isActive         Boolean  @default(true)
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        User?    @relation("DrillTemplateCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  deliveries       DrillDelivery[]
}

model DrillDelivery {
  id                String              @id @default(cuid())
  userId            String
  templateId        String
  trackingTokenHash String              @unique
  status            DrillDeliveryStatus
  purpose           DrillDeliveryPurpose @default(training)
  outcome           DrillOutcome        @default(pending)
  sentAt            DateTime?
  caughtAt          DateTime?
  expiresAt         DateTime
  sendErrorCode     String?
  triggeredByUserId String?
  createdAt         DateTime            @default(now())
  user              User                @relation("DrillRecipient", fields: [userId], references: [id], onDelete: Cascade)
  template          DrillTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  triggeredBy       User?               @relation("DrillTriggered", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  events            DrillEvent[]

  @@index([userId, createdAt])
  @@index([templateId, createdAt])
  @@index([status, createdAt])
  @@index([outcome, expiresAt])
  @@index([userId, purpose, sentAt])
}

model DrillEvent {
  id         String   @id @default(cuid())
  deliveryId String
  eventType  String
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())
  delivery   DrillDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([deliveryId, eventType])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  targetLabel String?
  metadata    Json?
  requestId   String?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

model PasswordResetToken {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailChangeRequest {
  id             String    @id @default(cuid())
  userId         String
  newEmail       String
  codeHash       String
  expiresAt      DateTime
  usedAt         DateTime?
  invalidatedAt  DateTime?
  failedAttempts Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([newEmail])
  @@index([expiresAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
